# Unreal Engine binary assets (Git LFS)
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap filter=lfs diff=lfs merge=lfs -text
*.ubulk filter=lfs diff=lfs merge=lfs -text
*.uexp filter=lfs diff=lfs merge=lfs -text
*.upk filter=lfs diff=lfs merge=lfs -text

# Normalize text files
*.ini text eol=crlf
*.uproject text eol=crlf
*.cpp text eol=crlf
*.h text eol=crlf
*.cs text eol=crlf
*.md text eol=crlf

# Sewer weapon source assets
Art/Weapons/Sewer/FBX/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Art/Weapons/Sewer/Blender/*.blend filter=lfs diff=lfs merge=lfs -text

# Ordinary toad source assets
Art/Mobs/Toad/FBX/*.fbx filter=lfs diff=lfs merge=lfs -text
Art/Mobs/Toad/Blender/*.blend filter=lfs diff=lfs merge=lfs -text
Art/Mobs/Toad/Preview/*.mp4 filter=lfs diff=lfs merge=lfs -text
